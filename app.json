{
  "expo": {
    "name": "墨笺",
    "slug": "mojian-private-writer",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/mojian-icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "app.mojian.privatewriter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE5",
        "foregroundImage": "./assets/images/mojian-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.mojian.privatewriter",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE5",
          "image": "./assets/images/mojian-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许墨笺读取你选中的图片，以便将其插入本地文稿。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
